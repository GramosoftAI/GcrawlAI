# ==================== PostgreSQL Database Configuration ====================
POSTGRES_HOST=your_postgres_host_here
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_postgres_database_here
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
GLOBAL_BROWSER_POOL=3

# ==================== Security Configuration ====================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
ENCRYPTION_KEY=your_encryption_key_here

# ==================== Email Configuration ====================
EMAIL_HOST=smtp.your_email_host_here
EMAIL_PORT=587
EMAIL_USERNAME=your_email_username_here
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=your_email_from_here
EMAIL_FROM_NAME=your_email_from_name_here
EMAIL_USE_TLS=true
RESET_PASSWORD_URL=your_reset_password_url_here

#==================Continue with Google=========================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=your_google_callback_url_here

# ==================== Redis Configuration ====================
REDIS_URL=redis://localhost:6379/0

# ==================== Proxy Attempts Configuration ====================

# Attempt 1:
ATTEMPT_1_PROXY_HOST=your_attempt_1_proxy_host_here
ATTEMPT_1_PROXY_PORT=8080
ATTEMPT_1_PROXY_USER=your_attempt_1_proxy_user_here
ATTEMPT_1_PROXY_PASS=your_attempt_1_proxy_pass_here
NODEMAVEN_BASE_USER=your_nodemaven_base_user_here
NODEMAVEN_ISP_APIKEY=your_nodemaven_isp_apikey_here

# Attempt 2:
ATTEMPT_2_PROXY_HOST=your_attempt_2_proxy_host_here
ATTEMPT_2_PROXY_PORT=9999
ATTEMPT_2_PROXY_USER=your_attempt_2_proxy_user_here
ATTEMPT_2_PROXY_PASS=your_attempt_2_proxy_pass_here

# Attempt 3:
ATTEMPT_3_PROXY_HOST=your_attempt_3_proxy_host_here
ATTEMPT_3_PROXY_PORT=1000
ATTEMPT_3_PROXY_USER=your_attempt_3_proxy_user_here
ATTEMPT_3_PROXY_PASS=your_attempt_3_proxy_pass_here
# Crawling Attempts Provider Ordering
ATTEMPT_1=nodemaven
ATTEMPT_2=thordata
ATTEMPT_3=evomi_core

# ==================== Agent API Settings ====================
CRAWL_HEADLESS=false
API_ENV=development
DEBUG=true
# ==================== Google Search Proxy Configuration ====================
ALLOW_DDG_FALLBACK=true
SERPER_API_KEY=your_serper_api_key_here
EVOMI_PROXY_SERVER=your_evomi_proxy_server_here
EVOMI_PROXY_USERNAME=your_evomi_proxy_username_here
EVOMI_PROXY_PASSWORD=your_evomi_proxy_password_here

RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ==================== API Key Double Encryption ====================
API_SECRET_KEY=your_api_secret_key_here
DB_SECRET_KEY=your_db_secret_key_here

# ==================== AWS S3 Configuration ====================
AWS_REGION=your_aws_region_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=your_aws_s3_bucket_here

# ==================== Payment Gateway ==========================
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_payments_webhook_secret_here
